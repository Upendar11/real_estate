'", "originalText": "      ELSE 'AMOUNT_MISMATCH'", "fontSize": 13.154533844189016, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e790", "type": "text", "x": 72, "y": 346.88888888888886, "width": 260.4597701149425, "height": 16.44316730523627, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "hachure", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1813034498, "version": 1, "versionNonce": 108121636, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "    END AS reconciliation_status,", "originalText": "    END AS reconciliation_status,", "fontSize": 13.154533844189016, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e791", "type": "text", "x": 72, "y": 365.96296296296293, "width": 536.7049808429118, "height": 16.44316730523627, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "hachure", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1597513082, "version": 1, "versionNonce": 885264836, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "    COALESCE(o.expected_amount - p.total_payment, o.expected_amount)", "originalText": "    COALESCE(o.expected_amount - p.total_payment, o.expected_amount)", "fontSize": 13.154533844189016, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {}}